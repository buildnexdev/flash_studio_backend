# ---------------------------------------------------------------
# BuildNexDev Photo Studio Platform - API configuration
# Copy to .env and fill in. Never commit the real .env file.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

# mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Aiven example (SSL required):
# DATABASE_URL=mysql://avnadmin:PASSWORD@HOST:11348/admin_panel?ssl-mode=REQUIRED
DATABASE_URL=mysql://root:root@localhost:3306/photolab

# Long random strings (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
# Used to sign local file URLs and encrypt stored QR tokens
APP_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
# Comma separated list of extra allowed CORS origins (e.g. Vercel preview URLs)
CORS_ORIGINS=

# Storage: "local" (private folder + HMAC signed URLs) or "s3" (any S3-compatible store)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
# Aliases also supported: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_S3_BUCKET
AWS_REGION=ap-south-1
AWS_BUCKET=
# Optional, for S3-compatible providers (MinIO, Wasabi, R2, DigitalOcean Spaces)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
SIGNED_URL_TTL_SECONDS=300

# Payments: "razorpay" or "devpay" (devpay is refused when NODE_ENV=production)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CURRENCY=INR

# Email (in-app notifications always work; email is sent when SMTP_HOST is set)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="BuildNexDev Studio <no-reply@example.com>"

# WhatsApp Cloud API (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# SMS over a generic HTTP gateway (optional). {to} and {message} are substituted.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=

# OTP login (codes are delivered over SMS/WhatsApp/email when configured)
OTP_ENABLED=true

# AI module: "off" or "rekognition" (uses the AWS credentials above)
AI_FACE_PROVIDER=off
AI_CULLING_ENABLED=true

# Uploads
MAX_UPLOAD_MB=40
UPLOAD_CONCURRENCY=2

# First administrator, created by "npm run db:seed" in production (test accounts are only seeded outside production)
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Password for the non-production test accounts (default PhotoLab@2026)
SEED_PASSWORD=
